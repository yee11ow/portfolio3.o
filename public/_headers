# Headers for Cloudflare Pages.
#
# CSP: deny by default, allow same-origin only. Inline scripts are blocked.
# The unpkg + elevenlabs entries are for the assistant
# widget, which only loads after the visitor clicks. If it fails to appear,
# the console names the blocked host: add it here.
#
# HSTS without preload (preload is hard to undo).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' https://unpkg.com https://api.elevenlabs.io wss://api.elevenlabs.io https://api.us.elevenlabs.io wss://api.us.elevenlabs.io; worker-src 'self' blob:; child-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), payment=(), usb=(), microphone=(self)
  Cross-Origin-Opener-Policy: same-origin

# Font filenames are stable and their contents never change in place.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Stable icon assets can be cached for a week.
/assets/*.svg
  Cache-Control: public, max-age=604800
