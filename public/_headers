# Cloudflare Pages reads this file and applies the headers below.
#
# The Content-Security-Policy is the point of it: the legal page promises that
# opening this site contacts nobody but this domain, and this is what makes the
# browser enforce that rather than take our word for it. Everything is denied
# by default and only same-origin assets are allowed back in — which is also
# why the language script lives in assets/boot.js instead of inline.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Font filenames are stable and their contents never change in place.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Shorter, because these are placeholders due to be swapped for real
# screenshots and a real photograph.
/assets/*.svg
  Cache-Control: public, max-age=604800
